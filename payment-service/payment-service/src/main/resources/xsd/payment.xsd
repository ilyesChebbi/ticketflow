<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://ticketflow.com/payment/v1"
           xmlns:tns="http://ticketflow.com/payment/v1"
           elementFormDefault="qualified">

  <xs:element name="authorizePaymentRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="orderId" type="xs:string"/>
        <xs:element name="amount" type="xs:decimal"/>
        <xs:element name="currency" type="xs:string"/>
        <xs:element name="cardToken" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="authorizePaymentResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="transactionId" type="xs:string"/>
        <xs:element name="status" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="refundPaymentRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="transactionId" type="xs:string"/>
        <xs:element name="amount" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="refundPaymentResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="refundId" type="xs:string"/>
        <xs:element name="status" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
